# Required
MONGO_URI=mongodb://localhost:27017/dieumerci
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# openssl rand -base64 32
RECEIPT_TOKEN_ENCRYPTION_KEY=
# Required in production (comma separated)
CLIENT_URL=http://localhost:5173

# Security (optional; safe defaults shown)
# Session length: e.g. 8h, 12h, 1d (default 12h)
JWT_EXPIRES_IN=12h
# Requests per minute per IP address on /api (default 600)
API_RATE_LIMIT_PER_MINUTE=600
# true = print debug logs in production (leave empty normally)
DEBUG_LOGS=

NODE_ENV=development
PORT=5000

# Optional
SUPER_ADMIN_EMAIL=
ADMIN_EMAILS=
DEFAULT_ADMIN_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
APP_URL=
POS_URL=

# Audit trail
AUDIT_RETENTION_DAYS=
AUDIT_BUSINESS_HOURS=6-21
